# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=<generate-a-strong-random-secret-min-64-chars>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Frontend origins allowed by CORS (comma-separated; set deployed frontend origin in Render)
FRONTEND_URL=http://localhost:3000
LOCALHOST_URL=http://localhost:3000

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Email Service (Resend)
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=concierge@equalirio-resort.com

# Brevo transactional email (email verification)
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=<verified-sender-email-in-brevo>
BREVO_SENDER_NAME=Equalirio Resort

# Razorpay Payment Gateway (Test or Live keys from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_optional
